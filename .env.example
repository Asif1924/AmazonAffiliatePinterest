# Amazon Affiliate Pinterest Automation - Environment Variables
# Copy this file to .env and fill in your values
# Note: The main configuration is in config.py, but you can use environment variables if preferred

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_FILE=credentials/google_service_account.json

# LLM Provider (openai, anthropic, google, openrouter)
LLM_PROVIDER=openai

# API Keys (only fill in the one you're using)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=sk-or-...

# Product Selection
DAILY_COUNT=10
COOLDOWN_DAYS=14
MIN_READY_PRODUCTS=20

# Output
OUTPUT_DIR=./daily_csv

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/pinterest_automation.log

